# Bu dosyayı kopyalayıp proje kökünde ".env" adıyla kaydet, gerçek
# değerlerini gir. .env dosyası .gitignore'da olduğu için repoya girmez.
#
# Supabase Dashboard > Settings > API üzerinden alınır.
# (Bunlar "anon/public" key'lerdir — tarayıcıya gönderilmek üzere
# tasarlanmışlardır, sızdırılsa bile güvenlik RLS ile sağlanır.)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
